<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="25dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to"
                android:textColor="#607D8B"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JibonSetu"
                android:textColor="#00695C"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Flood Rescue &amp; Emergency Support"
                android:textColor="#546E7A"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- Hero Image -->

        <ImageView
            android:id="@+id/ivFloodImage"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:contentDescription="Flood rescue"
            android:scaleType="centerCrop"
            android:src="@drawable/flood_rescue" />


        <!-- Greeting -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello, Hope Seeker"
                android:textColor="#0D47A1"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="You are not alone. JibonSetu is here to help you."
                android:textColor="#607D8B"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- SOS Button -->

        <Button
            android:id="@+id/btnSOS"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:text="🚨  SOS EMERGENCY"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:elevation="6dp" />


        <!-- Request Rescue -->

        <LinearLayout
            android:id="@+id/cardRequestRescue"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="#E0F2F1"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛶  Request Rescue"
                android:textColor="#00695C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Send a rescue request with your location"
                android:textColor="#546E7A"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Location -->

        <LinearLayout
            android:id="@+id/cardLocation"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="#E3F2FD"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍  My Location"
                android:textColor="#0D47A1"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Share your current location"
                android:textColor="#546E7A"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Rescue Teams -->

        <LinearLayout
            android:id="@+id/cardTeams"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="#EDE7F6"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚑  Nearby Rescue Teams"
                android:textColor="#4527A0"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Find rescue teams nearby"
                android:textColor="#546E7A"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Emergency Contacts -->

        <LinearLayout
            android:id="@+id/cardEmergency"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="#FFEBEE"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞  Emergency Contacts"
                android:textColor="#C62828"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Call for urgent help"
                android:textColor="#546E7A"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- My Requests -->

        <LinearLayout
            android:id="@+id/cardRequests"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="25dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="#E1F5FE"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋  My Rescue Requests"
                android:textColor="#01579B"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="View your rescue requests and status"
                android:textColor="#546E7A"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>